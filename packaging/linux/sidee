#!/bin/sh
# Sidee launcher for packaged and per-user Linux installs.
#
# SIDEE_HOME overrides the program directory (useful for testing a checkout).
# The bundled TV connection library in vendor/ is preferred when present, so a
# self-contained install works without any distribution Python packages.
# install.sh rewrites the line below when Sidee lives outside the usual prefixes.
set -eu

sidee_home_installed=
sidee_home=
for candidate in "${SIDEE_HOME:-}" "$sidee_home_installed" \
        /usr/share/sidee /usr/local/share/sidee \
        "${XDG_DATA_HOME:-$HOME/.local/share}/sidee"; do
    if [ -n "$candidate" ] && [ -f "$candidate/sidee.py" ]; then
        sidee_home=$candidate
        break
    fi
done
if [ -z "$sidee_home" ]; then
    echo "Sidee program files were not found. Reinstall Sidee or set SIDEE_HOME." >&2
    exit 1
fi

supports_sidee() {
    "$1" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)' \
        >/dev/null 2>&1
}

python=
for candidate in python3 python3.14 python3.13 python3.12 python3.11 \
        python3.10 python3.9 python; do
    if command -v "$candidate" >/dev/null 2>&1 && supports_sidee "$candidate"; then
        python=$candidate
        break
    fi
done
if [ -z "$python" ]; then
    echo "Python 3.9 or newer is required to run Sidee. Install python3 and try again." >&2
    exit 1
fi

if [ -d "$sidee_home/vendor" ]; then
    PYTHONPATH="$sidee_home/vendor${PYTHONPATH:+:$PYTHONPATH}"
    export PYTHONPATH
fi

exec "$python" "$sidee_home/sidee.py" "$@"
